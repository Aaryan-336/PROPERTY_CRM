# --- Required ---------------------------------------------------------------

# Must match WHATSAPP_INGEST_SECRET in backend/.env exactly. The gateway signs
# every request with it and the API refuses anything unsigned.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHATSAPP_INGEST_SECRET=

# Where the CRM API is reachable from this machine.
API_BASE_URL=http://127.0.0.1:8000

# --- Session storage --------------------------------------------------------

# This directory IS the WhatsApp login. Anyone who copies it can read every
# group the account is in. Keep it off shared drives, out of git, and back it
# up only somewhere you would keep a password.
WHATSAPP_AUTH_DIR=./.wa-session

# Disk journal of messages not yet acknowledged by the API.
OUTBOX_FILE=./.wa-outbox.jsonl

# --- Tuning -----------------------------------------------------------------

BATCH_SIZE=25
FLUSH_INTERVAL_MS=3000

# How often to re-read the monitored-group list from the CRM, so toggling a
# group in the UI takes effect without a restart.
GROUP_REFRESH_MS=60000

# How often to check whether the owner has pressed something in the CRM
# ("Connect WhatsApp", "Refresh group list"). Sits behind a button press
# somebody is watching, so keep it short.
COMMAND_POLL_MS=4000

# Minimum gap between two re-pairings. Clearing the session and relinking is the
# most account-flagging thing this process does, and the button that triggers it
# is one tap on a phone — a double tap must not become two relinks.
REPAIR_COOLDOWN_MS=60000

# Only needed on hosts that require a process to answer HTTP (Render, Fly,
# Railway). Set by the platform; leave unset locally. The endpoint reports
# connection state only — never the QR, which stays Owner-only behind the API.
# PORT=10000

RETRY_BASE_MS=2000
RETRY_MAX_MS=120000

# Ignore messages older than this on connect. Stops a fresh pairing from
# replaying weeks of scrollback and re-extracting listings that are long gone.
MAX_MESSAGE_AGE_MS=86400000

LOG_LEVEL=info
