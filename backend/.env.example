# Application DB role — deliberately NOT the owner of the tables.
# It has no UPDATE/DELETE grant on audit_log, so append-only is enforced by
# Postgres itself and not merely by application code (SECURITY_MODEL.md).
DATABASE_URL=postgresql+psycopg://balaji_app:balaji_dev_pw@localhost:5432/balaji_crm

# Migrations run as the table owner, which does have DDL rights.
MIGRATION_DATABASE_URL=postgresql+psycopg://balaji_migrator:balaji_dev_pw@localhost:5432/balaji_crm

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
# SECURITY_MODEL.md: sliding sessions with an absolute cap. IDLE is renewed on
# use, so it measures how long you can be *away* before signing in again;
# ABSOLUTE is measured from the password and is never extended. Shorten both if
# staff share a device.
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Max page size on every list endpoint. This is a security control
# (SECURITY_MODEL.md §4), not just a performance knob.
MAX_PAGE_SIZE=50

# Per-user request budget for list endpoints, to raise the cost of
# screen-by-screen manual scraping.
LIST_RATE_LIMIT_PER_MINUTE=60

CORS_ORIGINS=http://localhost:3000

# Web Push (VAPID). Leave blank to run without push; everything else works.
# Generate with: python -m app.tools.vapid_keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@balajicrm.local

# --- WhatsApp ingestion (Phase 3) --------------------------------------------

# Shared secret between the ingestion gateway and POST /internal/whatsapp/ingest.
# Must match gateway/.env exactly. Leave blank to disable the endpoint entirely
# (it fails closed — an unconfigured server accepts nothing).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHATSAPP_INGEST_SECRET=

# Replay window for a signed gateway request, in seconds.
WHATSAPP_INGEST_MAX_SKEW=300

# Credentials for the extraction worker. Without this the gateway still stores
# messages, but nothing becomes inventory — the CRM's Inventory feed screen
# says so explicitly rather than just showing zeros.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq retires model names on a fairly short cycle. If extraction starts
# failing with a 404 on the model, check the current list at
# https://console.groq.com/docs/models and set it here.
EXTRACTION_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# auto | json_schema | json_object
# "auto" asks for a strict JSON schema and permanently downgrades itself to
# plain JSON mode if the model refuses one, so switching models needs no
# config change. Pin it only to skip that one probe request.
EXTRACTION_SCHEMA_MODE=auto

# Run extraction inside the API process instead of as its own service.
# For hosts with no background workers (Render free plan), where the worker has
# nowhere to live and messages would sit as `pending` for ever.
EXTRACTION_IN_API=false

# Groq Whisper model for voice quick-add and call-recording transcription
# (same GROQ_API_KEY). Audio is transcribed in memory and never stored.
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# --- Meta Ads ------------------------------------------------------------------
# Meta developer app with the "Ads MCP" use case. Each CRM user authorizes their
# own Meta account; these only identify the app. All four of the first four
# must be set or the Meta Ads screen reports "not configured".
META_APP_ID=
META_APP_SECRET=
# This API's public URL + /meta-ads/oauth/callback. Register it on the Meta app
# as a Valid OAuth Redirect URI.
META_REDIRECT_URI=http://localhost:8000/meta-ads/oauth/callback
# Tokens are stored encrypted with this. Comma-separate to rotate (new first).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
META_TOKEN_ENCRYPTION_KEY=
# Where the browser lands after connecting. Default: first CORS origin + /meta-ads
META_POST_CONNECT_REDIRECT=
META_SCOPES=ads_mcp_management,ads_read,ads_management
META_GRAPH_VERSION=v25.0
META_ADS_MCP_URL=https://mcp.facebook.com/ads
# auto (MCP where a tool fits, else Graph) | mcp | graph
META_ADS_TRANSPORT=auto
# Optional JSON pinning MCP tool names, e.g. {"list_campaigns":"ads_get_campaigns"}
META_MCP_TOOLS=
