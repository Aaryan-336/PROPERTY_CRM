# Application DB role — deliberately NOT the owner of the tables.
# It has no UPDATE/DELETE grant on audit_log, so append-only is enforced by
# Postgres itself and not merely by application code (SECURITY_MODEL.md).
DATABASE_URL=postgresql+psycopg://balaji_app:balaji_dev_pw@localhost:5432/balaji_crm

# Migrations run as the table owner, which does have DDL rights.
MIGRATION_DATABASE_URL=postgresql+psycopg://balaji_migrator:balaji_dev_pw@localhost:5432/balaji_crm

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
JWT_ALGORITHM=HS256
# SECURITY_MODEL.md: 12-24h sessions requiring re-login, not indefinite tokens.
JWT_EXPIRY_HOURS=12

# Max page size on every list endpoint. This is a security control
# (SECURITY_MODEL.md §4), not just a performance knob.
MAX_PAGE_SIZE=50

# Per-user request budget for list endpoints, to raise the cost of
# screen-by-screen manual scraping.
LIST_RATE_LIMIT_PER_MINUTE=60

CORS_ORIGINS=http://localhost:3000

# Web Push (VAPID). Leave blank to run without push; everything else works.
# Generate with: python -m app.tools.vapid_keygen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@balajicrm.local

# --- WhatsApp ingestion (Phase 3) --------------------------------------------

# Shared secret between the ingestion gateway and POST /internal/whatsapp/ingest.
# Must match gateway/.env exactly. Leave blank to disable the endpoint entirely
# (it fails closed — an unconfigured server accepts nothing).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
WHATSAPP_INGEST_SECRET=

# Replay window for a signed gateway request, in seconds.
WHATSAPP_INGEST_MAX_SKEW=300

# Credentials for the extraction worker. Without this the gateway still stores
# messages, but nothing becomes inventory — the CRM's Inventory feed screen
# says so explicitly rather than just showing zeros.
ANTHROPIC_API_KEY=

# Extraction is a scoped task where low effort performs as well as high at a
# fraction of the token spend. Raise if a market's messages prove harder.
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_EFFORT=low
