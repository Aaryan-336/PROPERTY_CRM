# ---------------------------------------------------------------------------
# Secrets — never commit these.
# ---------------------------------------------------------------------------
# Every service keeps a committed .env.example; the real .env stays local.
.env
.env.*
!.env.example
!.env.*.example

# The WhatsApp gateway's session directory IS the login. Anyone who copies it
# can read every group the linked account is in.
.wa-session/
*.wa-session/

# Undelivered-message journal — contains real group message bodies.
.wa-outbox.jsonl
*.wa-outbox.jsonl*

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

.next/
out/
build/
dist/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Test and tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Local editor / OS / agent state
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# Personal, machine-specific Claude Code settings (permissions, local flags).
# The shared .claude/settings.json, if one is added, should be committed.
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
